{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "1280px",
      "wideSize": "1600px"
    },
    "color": {
      "custom": true,
      "customDuotone": false,
      "customGradient": true,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        {
          "slug": "lime",
          "color": "#ff7a1a",
          "name": "Rescue Orange"
        },
        {
          "slug": "primary",
          "color": "#ff7a1a",
          "name": "Rescue Orange Primary"
        },
        {
          "slug": "primary-dark",
          "color": "#e24e12",
          "name": "Rescue Orange Dark"
        },
        {
          "slug": "dark-green",
          "color": "#19202d",
          "name": "Midnight Slate"
        },
        {
          "slug": "deep-dark",
          "color": "#141923",
          "name": "Deep Dark Asphalt"
        },
        {
          "slug": "card",
          "color": "#242b3b",
          "name": "Card Slate"
        },
        {
          "slug": "white",
          "color": "#ffffff",
          "name": "Pure White"
        },
        {
          "slug": "dirty-white",
          "color": "#f3f4f6",
          "name": "Surface Off-White"
        },
        {
          "slug": "gray",
          "color": "#4b5563",
          "name": "Neutral Gray"
        },
        {
          "slug": "light-gray",
          "color": "#939ba8",
          "name": "Muted Slate"
        },
        {
          "slug": "success",
          "color": "#49c889",
          "name": "Operational Green"
        }
      ]
    },
    "typography": {
      "customFontSize": true,
      "fontFamilies": [
        {
          "fontFamily": "\"SuisseIntl\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif",
          "name": "Suisse Intl",
          "slug": "primary"
        },
        {
          "fontFamily": "\"Geist Mono\", ui-monospace, SFMono-Regular, Menlo, monospace",
          "name": "Geist Mono",
          "slug": "mono"
        }
      ]
    },
    "spacing": {
      "units": ["px", "em", "rem", "vh", "vw", "%"]
    }
  },
  "styles": {
    "color": {
      "background": "#ffffff",
      "text": "#052424"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--primary)",
      "lineHeight": "1.5"
    },
    "elements": {
      "link": {
        "color": {
          "text": "inherit"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--lime)",
          "text": "var(--wp--preset--color--dark-green)"
        },
        "border": {
          "radius": "4px"
        }
      }
    }
  }
}
