{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "1280px",
      "wideSize": "1600px"
    },
    "color": {
      "custom": true,
      "customDuotone": false,
      "customGradient": true,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        {
          "slug": "lime",
          "color": "#abff02",
          "name": "Lime Neon"
        },
        {
          "slug": "dark-green",
          "color": "#052424",
          "name": "Dark Green Terminal"
        },
        {
          "slug": "deep-dark",
          "color": "#021313",
          "name": "Deep Industrial Night"
        },
        {
          "slug": "white",
          "color": "#ffffff",
          "name": "Pure White"
        },
        {
          "slug": "dirty-white",
          "color": "#f0f0f0",
          "name": "Dirty White Surface"
        },
        {
          "slug": "gray",
          "color": "#454742",
          "name": "Terminal Slate Gray"
        },
        {
          "slug": "light-gray",
          "color": "#c2c2c2",
          "name": "Technical Light Gray"
        },
        {
          "slug": "orange-alert",
          "color": "#fb6b3c",
          "name": "Rescue Orange"
        }
      ]
    },
    "typography": {
      "customFontSize": true,
      "fontFamilies": [
        {
          "fontFamily": "\"SuisseIntl\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif",
          "name": "Suisse Intl",
          "slug": "primary"
        },
        {
          "fontFamily": "\"Geist Mono\", ui-monospace, SFMono-Regular, Menlo, monospace",
          "name": "Geist Mono",
          "slug": "mono"
        }
      ]
    },
    "spacing": {
      "units": ["px", "em", "rem", "vh", "vw", "%"]
    }
  },
  "styles": {
    "color": {
      "background": "#ffffff",
      "text": "#052424"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--primary)",
      "lineHeight": "1.5"
    },
    "elements": {
      "link": {
        "color": {
          "text": "inherit"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--lime)",
          "text": "var(--wp--preset--color--dark-green)"
        },
        "border": {
          "radius": "4px"
        }
      }
    }
  }
}
